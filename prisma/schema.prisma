generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model User {
  id           String     @id @default(cuid())
  username     String     @unique
  passwordHash String
  displayName  String
  role         String     @default("OWNER")
  createdAt    DateTime   @default(now())
  purchases    Purchase[]
  bills        Bill[]
  returns      BillReturn[]
}

model Variety {
  id        String      @id @default(cuid())
  name      String      @unique
  category  String?
  createdAt DateTime    @default(now())
  stocks    StockItem[]
  purchases Purchase[]
  saleItems SaleItem[]
}

// Stock of one variety in one kind of packaging ("BAG" or "OPEN"), with its own cost and price.
model StockItem {
  id             String   @id @default(cuid())
  varietyId      String
  variety        Variety  @relation(fields: [varietyId], references: [id])
  packaging      String
  currentStockKg Float    @default(0)
  avgCostPerKg   Float    @default(0)
  pricePerKg     Float    @default(0)
  reorderLevel   Float    @default(0)
  createdAt      DateTime @default(now())
  // Set when the owner deletes this stock. It disappears everywhere except old bills and reports.
  archivedAt     DateTime?

  @@unique([varietyId, packaging])
}

model Purchase {
  id           String   @id @default(cuid())
  varietyId    String
  variety      Variety  @relation(fields: [varietyId], references: [id])
  packaging    String   @default("OPEN")
  qtyKg        Float
  ratePerKg    Float
  totalCost    Float
  supplierName String?
  purchaseDate DateTime
  createdById  String
  createdBy    User     @relation(fields: [createdById], references: [id])
  createdAt    DateTime @default(now())

  @@index([varietyId])
  @@index([purchaseDate])
}

model Bill {
  id             String     @id @default(cuid())
  billNumber     Int        @unique
  customerName   String?
  customerPhone  String?
  subtotal       Float
  discountType   String     @default("AMOUNT")
  discountValue  Float      @default(0)
  discountAmount Float      @default(0)
  total          Float
  paymentMethod  String     @default("CASH")
  amountReceived Float
  amountDue      Float      @default(0)
  billDate       DateTime
  createdById    String
  createdBy      User       @relation(fields: [createdById], references: [id])
  createdAt      DateTime   @default(now())
  items          SaleItem[]
  returns        BillReturn[]

  @@index([billDate])
}

model SaleItem {
  id           String   @id @default(cuid())
  billId       String
  bill         Bill     @relation(fields: [billId], references: [id], onDelete: Cascade)
  varietyId    String
  variety      Variety  @relation(fields: [varietyId], references: [id])
  packaging    String   @default("OPEN")
  qtyKg        Float
  ratePerKg    Float
  totalRevenue Float
  costAtSale   Float
  profit       Float
  // Kilos of this line already taken back by returns.
  returnedKg   Float    @default(0)
  returnItems  ReturnItem[]

  @@index([varietyId])
  @@index([billId])
}

// A refund: the customer brings rice back from a bill and gets money back (or less owed).
model BillReturn {
  id           String       @id @default(cuid())
  billId       String
  bill         Bill         @relation(fields: [billId], references: [id])
  refundAmount Float
  // Part of the refund that just reduced what the customer still owed on credit.
  dueReduced   Float        @default(0)
  // The rest, handed back as cash.
  cashRefunded Float
  note         String?
  returnDate   DateTime     @default(now())
  createdById  String
  createdBy    User         @relation(fields: [createdById], references: [id])
  items        ReturnItem[]

  @@index([billId])
  @@index([returnDate])
}

model ReturnItem {
  id              String     @id @default(cuid())
  returnId        String
  return          BillReturn @relation(fields: [returnId], references: [id], onDelete: Cascade)
  saleItemId      String
  saleItem        SaleItem   @relation(fields: [saleItemId], references: [id])
  qtyKg           Float
  refundAmount    Float
  // What to take off the sales reports: gross revenue, cost and profit of the returned kilos
  // (same basis the reports use), plus the bill discount that is given back with them.
  revenueReversed  Float
  costReversed     Float
  profitReversed   Float
  discountReversed Float

  @@index([saleItemId])
  @@index([returnId])
}
