generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model User {
  id           String     @id @default(cuid())
  username     String     @unique
  passwordHash String
  displayName  String
  role         String     @default("OWNER")
  createdAt    DateTime   @default(now())
  purchases    Purchase[]
  bills        Bill[]
}

model Variety {
  id             String     @id @default(cuid())
  name           String     @unique
  category       String?
  currentStockKg Float      @default(0)
  avgCostPerKg   Float      @default(0)
  pricePerKg     Float      @default(0)
  reorderLevel   Float      @default(0)
  createdAt      DateTime   @default(now())
  purchases      Purchase[]
  saleItems      SaleItem[]
}

model Purchase {
  id           String   @id @default(cuid())
  varietyId    String
  variety      Variety  @relation(fields: [varietyId], references: [id])
  qtyKg        Float
  ratePerKg    Float
  totalCost    Float
  supplierName String?
  purchaseDate DateTime
  createdById  String
  createdBy    User     @relation(fields: [createdById], references: [id])
  createdAt    DateTime @default(now())

  @@index([varietyId])
  @@index([purchaseDate])
}

model Bill {
  id             String     @id @default(cuid())
  billNumber     Int        @unique
  customerName   String?
  customerPhone  String?
  subtotal       Float
  discountType   String     @default("AMOUNT")
  discountValue  Float      @default(0)
  discountAmount Float      @default(0)
  total          Float
  paymentMethod  String     @default("CASH")
  amountReceived Float
  amountDue      Float      @default(0)
  billDate       DateTime
  createdById    String
  createdBy      User       @relation(fields: [createdById], references: [id])
  createdAt      DateTime   @default(now())
  items          SaleItem[]

  @@index([billDate])
}

model SaleItem {
  id           String   @id @default(cuid())
  billId       String
  bill         Bill     @relation(fields: [billId], references: [id], onDelete: Cascade)
  varietyId    String
  variety      Variety  @relation(fields: [varietyId], references: [id])
  qtyKg        Float
  ratePerKg    Float
  totalRevenue Float
  costAtSale   Float
  profit       Float

  @@index([varietyId])
  @@index([billId])
}
